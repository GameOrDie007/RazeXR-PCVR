// Team Beef Discord, September 2026. See THIRD-PARTY-PERMISSIONS.md.
//
// The models these name are NOT redistributed. tools/build-vrweapons.ps1
// assembles them on the user's machine: the ones that are the game's own
// pickup voxels come out of their own game archives, Duke's come from
// Cheello's Voxel Duke 3D, and Domyoji's animation frames and edits are
// overlaid only when a VRaze install is supplied.

dummytile 30703 1 1

voxel "models/weapons/sw/vr_fist.kvx"          { tile 30000  scale 1.0 }
voxel "models/weapons/sw/vr_star.kvx"          { tile 30010  scale 0.3 }
voxel "models/weapons/sw/vr_shotgun.kvx"       { tile 30020  scale 0.4 }
