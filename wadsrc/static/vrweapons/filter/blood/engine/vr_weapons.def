voxel "models/weapons/blood/vr_shotgun.kvx"    { tile 30020  scale 0.45 }
voxel "models/weapons/blood/vr_tommygun.kvx"   { tile 30030  scale 0.3 }
voxel "models/weapons/blood/vr_napalm0.kvx"    { tile 30040  scale 0.5 }
voxel "models/weapons/blood/vr_napalm1.kvx"    { tile 30041  scale 0.5 }
