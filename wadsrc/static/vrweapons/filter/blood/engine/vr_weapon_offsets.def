// Player height: 60

weapon pitchfork
{
    blood_gimbal_lock_fix  1
    forward   0
    right     0
    up        -60
    yaw       0
    pitch     0
    roll      0
    pivot_x   0
    pivot_y   0
    pivot_z   0
    two_hand_compatible  1
}

