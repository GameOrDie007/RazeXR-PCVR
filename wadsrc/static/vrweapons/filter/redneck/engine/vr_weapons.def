// Cheello's Voxel Duke 3D, and Domyoji's animation frames and edits are
// overlaid only when a VRaze install is supplied.

dummytile 30703 1 1

voxel "models/weapons/rr/vr_weapon_rr_crowbar.kvx"   { tile 30000  scale 0.2 }
voxel "models/weapons/rr/vr_weapon_rr_pistol.kvx"    { tile 30010  scale 0.15 }
voxel "models/weapons/rr/vr_weapon_rr_shotgun.kvx"   { tile 30020  scale 0.25 }
voxel "models/weapons/rr/vr_weapon_rr_rifle.kvx"     { tile 30030  scale 0.2 }
voxel "models/weapons/rr/vr_weapon_rr_dynamite.kvx"  { tile 30040  scale 0.1 }
voxel "models/weapons/rr/vr_weapon_rr_crossbow.kvx"  { tile 30050  scale 0.15 }
voxel "models/weapons/rr/vr_weapon_rr_throwsaw.kvx"  { tile 30060  scale 0.2 }
voxel "models/weapons/rr/vr_weapon_rr_blaster.kvx"   { tile 30070  scale 0.15 }
voxel "models/weapons/rr/vr_weapon_rr_powderkeg.kvx" { tile 30080  scale 0.15 }
voxel "models/weapons/rr/vr_weapon_rr_titgun.kvx"    { tile 30090  scale 0.25 }
voxel "models/weapons/rr/vr_weapon_rr_throwdyn.kvx"  { tile 30100  scale 0.1 }
