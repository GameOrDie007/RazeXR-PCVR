//
// The models these name are NOT redistributed. tools/build-vrweapons.ps1
// assembles them on the user's machine: the ones that are the game's own
// pickup voxels come out of their own game archives, Duke's come from
// Cheello's Voxel Duke 3D, and Domyoji's animation frames and edits are
// overlaid only when a VRaze install is supplied.

dummytile 30703 1 1

voxel "models/weapons/exhumed/vr_sword.kvx"       { tile 30000  scale 0.3 }
voxel "models/weapons/exhumed/vr_pistol.kvx"      { tile 30010  scale 0.25 }
voxel "models/weapons/exhumed/vr_m60.kvx"         { tile 30020  scale 0.3 }
voxel "models/weapons/exhumed/vr_flamer.kvx"      { tile 30030  scale 0.3 }
voxel "models/weapons/exhumed/vr_grenade.kvx"     { tile 30040  scale 0.3 }
voxel "models/weapons/exhumed/vr_staff.kvx"       { tile 30050  scale 0.45 }
voxel "models/weapons/exhumed/vr_ring.kvx"        { tile 30060  scale 0.5 }
voxel "models/weapons/exhumed/vr_mummified.kvx"   { tile 30070  scale 0.3 }
