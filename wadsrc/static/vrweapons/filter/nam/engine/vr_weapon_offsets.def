//
// The models these name are NOT redistributed. tools/build-vrweapons.ps1
// assembles them on the user's machine: the ones that are the game's own
// pickup voxels come out of their own game archives, Duke's come from
// Cheello's Voxel Duke 3D, and Domyoji's animation frames and edits are
// overlaid only when a VRaze install is supplied.

// Player height: 40

//   knee       slot 0  Knife
//   pistol     slot 1  Rifle (M16)
//   shotgun    slot 2  Shotgun
//   chaingun   slot 3  Machine Gun
//   rpg        slot 4  LAW Launcher
//   handbomb   slot 5  Grenade
//   shrinker   slot 6  Grenade Launcher / Sniper Rifle (toggles)
//   devastator slot 7  Rocket Launcher
//   tripbomb   slot 8  Claymore
//   freeze     slot 9  Flamethrower

weapon knee
{
    forward   0
    right     0
    up        -40
    yaw       0
    pitch     0
    roll      0
    pivot_x   0
    pivot_y   0
    pivot_z   0
    gimbal_lock_fix  1
}

