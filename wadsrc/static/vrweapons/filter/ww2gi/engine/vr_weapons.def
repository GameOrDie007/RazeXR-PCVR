voxel "models/weapons/ww2gi/vr_weapon_ww2gi_bar.kvx"              { tile 30030  scale 0.3 }
voxel "models/weapons/ww2gi/vr_weapon_ww2gi_bazooka.kvx"          { tile 30040  scale 0.3 }
voxel "models/weapons/ww2gi/vr_weapon_ww2gi_grenade.kvx"          { tile 30050  scale 0.1 }
voxel "models/weapons/ww2gi/vr_weapon_ww2gi_garand_launcher.kvx"  { tile 30060  scale 0.2 }
voxel "models/weapons/ww2gi/vr_weapon_ww2gi_mauser.kvx"           { tile 30061  scale 0.3 }
