// Team Beef Discord, September 2026. See THIRD-PARTY-PERMISSIONS.md.
//
// The models these name are NOT redistributed. tools/build-vrweapons.ps1
// assembles them on the user's machine: the ones that are the game's own
// pickup voxels come out of their own game archives, Duke's come from
// Cheello's Voxel Duke 3D, and Domyoji's animation frames and edits are
// overlaid only when a VRaze install is supplied.

// Player height: 40

//   knee       slot 0   Knife
//   pistol     slot 1   M1 Thompson
//   shotgun    slot 2   MP40
//   chaingun   slot 3   BAR Automatic Rifle
//   rpg        slot 4   Bazooka
//   handbomb   slot 5   Grenade
//   shrinker   slot 6   Garand Grenade Launcher (6A) / Mauser Sniper Rifle (6B, toggle)
//   devastator slot 7   Colt 1911
//   tripbomb   slot 8   TNT
//   freeze     slot 9   Flame Thrower

weapon knee
{
    forward   0
    right     0
    up        -40
    yaw       0
    pitch     0
    roll      0
    pivot_x   0
    pivot_y   0
    pivot_z   0
    gimbal_lock_fix  1
}

